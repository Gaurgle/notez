#!/usr/bin/env bash
# Reports how this repo's Relay files stand against the Relay skill. Report
# only: it never edits. Run by the lead on start (Claude or Codex).
#
# Checks: the template version stamped in docs/agent-workflow.md against the
# skill's VERSION (with the changelog entries marked [migrate] since then),
# that the Relay scripts are present, leftover {{placeholders}}, the
# handoff's length and expired standing-authority rows. A cloud session
# without the skill still gets the repo-side checks.
#
# Exit 1 when the handoff is over RELAY_HANDOFF_MAX lines (default 60) or
# a standing-authority row's "Until" date has passed: the lead fixes the
# baton before dispatching. Everything else is a report.
#
# Usage: scripts/relay-check [path-to-relay-skill]

set -uo pipefail

root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
cd "$root"

skill=${1:-}
if [ -z "$skill" ]; then
  for dir in "$HOME/.claude/skills/relay" "$HOME/claude-config/skills/relay"; do
    if [ -f "$dir/VERSION" ]; then skill=$dir; break; fi
  done
fi

stamp=$(sed -n 's/.*<!-- relay-template: \([0-9][0-9.]*\).*-->.*/\1/p' \
  docs/agent-workflow.md 2>/dev/null | head -1)
deviations=$(sed -n 's/.*<!-- relay-template: .*local-deviations: \(.*\) -->.*/\1/p' \
  docs/agent-workflow.md 2>/dev/null | head -1)

echo "Template in this repo: ${stamp:-none (copied before versioning)}"
[ -n "$deviations" ] && echo "Deliberate local deviations: $deviations"

if [ -z "$skill" ]; then
  echo "Relay skill not visible here (cloud session?): version not compared."
else
  current=$(tr -d '[:space:]' < "$skill/VERSION")
  echo "Relay skill: $current"
  if [ "${stamp:-0}" = "$current" ]; then
    echo "Up to date."
  else
    echo "Changes since ${stamp:-the first version} that instances should adopt:"
    # Sections are "## <version> (<date>)"; print [migrate] lines of every
    # section newer than the stamp.
    awk -v have="${stamp:-0}" '
      function newer(a, b,   x, y, i, n) {
        n = split(a, x, "."); split(b, y, ".")
        for (i = 1; i <= 3; i++) {
          if (x[i] + 0 > y[i] + 0) return 1
          if (x[i] + 0 < y[i] + 0) return 0
        }
        return 0
      }
      /^## [0-9]/ { show = newer($2, have); version = $2; next }
      show && /\[migrate\]/ { print "  " version ": " $0 }
    ' "$skill/CHANGELOG.md"
    echo "Migrating is a change the owner asks for; this check only reports."
  fi
fi

for script in scripts/relay-sweep scripts/relay-check scripts/relay-status scripts/relay-board scripts/relay-scope scripts/relay-retro; do
  [ -x "$script" ] || echo "Missing or not executable: $script"
done

leftovers=$(grep -l '{{' docs/agent-workflow.md docs/agent-handoff.md AGENTS.md \
  .claude/agents/*.md 2>/dev/null)
[ -n "$leftovers" ] && echo "Unfilled {{placeholders}} in: $leftovers"

status=0
if [ -f docs/agent-handoff.md ]; then
  max=${RELAY_HANDOFF_MAX:-60}
  lines=$(wc -l < docs/agent-handoff.md | tr -d ' ')
  if [ "$lines" -gt "$max" ]; then
    echo "Handoff: $lines lines, limit $max. Move finished tickets and dated words to docs/agent-log.md and ticket detail to the issues before dispatching."
    status=1
  else
    echo "Handoff: $lines lines."
  fi
  # Standing-authority rows: "| what | granted | scope | until |". An Until
  # that is a past date is expired; words (a milestone, "revoked by word")
  # are not checked.
  today=$(date +%Y-%m-%d)
  expired=$(awk -F'|' -v today="$today" '
    /^## Standing authority/ { on = 1; next }
    /^## / { on = 0 }
    on && /^\|/ && NF >= 6 {
      until = $5; gsub(/^[ \t]+|[ \t]+$/, "", until)
      what = $2; gsub(/^[ \t]+|[ \t]+$/, "", what)
      if (until ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ && until < today)
        print "  expired " until ": " what
    }' docs/agent-handoff.md)
  if [ -n "$expired" ]; then
    echo "Standing authority past its date (ask the owner to renew or strike, then move the row to the log):"
    echo "$expired"
    status=1
  fi
fi
exit "$status"
